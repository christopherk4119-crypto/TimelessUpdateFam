# Netlify-style headers file — sets long cache lifetimes for static assets
# so returning visitors don't re-download images/CSS on every page load.
# (Cloudflare Pages also reads this file natively. Other hosts need the
# equivalent set in their own config — see SEO-UPDATE-HANDOFF.md.)

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=0, must-revalidate
